DATABASE_URL=jdbc:postgresql://localhost:5432/thunai
DATABASE_USERNAME=thunai
DATABASE_PASSWORD=thunai
REDIS_HOST=localhost
CONSUL_HOST=localhost
SPRING_PROFILES_ACTIVE=local

# --- Free SMS via capcom6 SMS Gateway for Android (https://github.com/capcom6/android-sms-gateway) ---
# Install the app on an Android phone with a SIM, create credentials, set them here.
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# SMS_GATEWAY_SIM_NUMBER=1
# Tenant assigned to inbound SMS until recipient->tenant lookup exists (single-tenant MVP).
SMS_GATEWAY_DEFAULT_TENANT_ID=
